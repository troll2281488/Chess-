{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || (data.child('guest').val() === null && newData.child('guest').val() === auth.uid)) && newData.child('host').val() === data.child('host').val()) )",
        ".validate": "newData.hasChildren(['fen','host','moves'])",
        "fen": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "host": { ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && newData.val() === data.val()))" },
        "guest": { ".validate": "newData.val() === null || newData.val() === auth.uid || newData.val() === data.val()" },
        "hostName": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "guestName": { ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 24)" },
        "fen": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "moves": { ".validate": "newData.isList() && newData.numChildren() <= 500" },
        "createdAt": { ".validate": "newData.isNumber() || newData.hasChildren()" },
        "updatedAt": { ".validate": "newData.isNumber() || newData.hasChildren()" },
        "quick": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "quickQueue": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['room','createdAt'])",
        "room": { ".validate": "newData.isString() && newData.val().length === 6" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "$other": { ".validate": false }
      }
    }
  }
}